{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "BUILD SDL",
            "command": "C:/Libs/mingw64/bin/gcc.exe",
            "args": [
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-pedantic-errors",
                "-Werror",
                "-fno-builtin",
                "-g",
                "${file}",
                "-I",
                "D:/LIBS/SDL3-3.4.16/include",
                "-L",
                "D:/LIBS/SDL3-3.4.16/lib",
                "-lSDL3",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
