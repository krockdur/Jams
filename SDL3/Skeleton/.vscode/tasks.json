            "options": {
                "cwd": "C:/Libs/mingw64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "COMPILE SDL",
            "command": "C:/Libs/mingw64/bin/gcc.exe",
            "args": [
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-pedantic-errors",
                "-Werror",
                "-fsyntax-only",
                "${file}",
                "-I",
                "D:/LIBS/SDL3-3.4.16/include"
            ],
            "options": {
                "cwd": "C:/Libs/mingw64/bin"
            },
            "problemMatcher": [
                "$gcc"
